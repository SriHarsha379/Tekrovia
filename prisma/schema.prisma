generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TRAINER
  COUNSELLOR
  SUPPORT_STAFF
  PLACEMENT_MANAGER
  RECRUITER
  ADMIN
  SUPER_ADMIN
}

enum CandidateClassification {
  BEGINNER
  STARTER
  PRO
}

enum AssessmentType {
  FREE_ASSESSMENT
  CAREER_READINESS
  TECHNICAL
  MOCK_INTERVIEW
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  PROSPECT
  PIPELINE
  PENDING_CLOSURE
  ENROLLED
  DROPPED
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(STUDENT)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate                    Candidate?
  sessions                     Session[]
  otpCodes                     OtpCode[]
  leadsOwned                   Lead[]                 @relation("LeadOwner")
  assessments                  Assessment[]
  enrollments                  Enrollment[]
  lessonProgress               LessonProgress[]
  auditLogs                    AuditLog[]
  placementApplicationsCreated PlacementApplication[] @relation("PlacementApplicationCreator")
  assignmentSubmissions        AssignmentSubmission[] @relation("AssignmentSubmitter")
  assignmentsReviewed          AssignmentSubmission[] @relation("AssignmentReviewer")
  projectSubmissions           ProjectSubmission[]    @relation("ProjectSubmitter")
  projectsReviewed             ProjectSubmission[]    @relation("ProjectReviewer")

  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String    @unique
  refreshToken String    @unique
  deviceInfo   String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String    @default("login")
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([purpose])
  @@map("otp_codes")
}

model Candidate {
  id                   String                   @id @default(cuid())
  candidateCode        String                   @unique
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  email                String                   @unique
  phone                String                   @unique
  education            String?
  graduationYear       Int?
  experienceYears      Int                      @default(0)
  currentEmployment    String?
  skills               String[]
  previousTraining     String?
  careerGapMonths      Int                      @default(0)
  targetRole           String?
  codingPreference     String?
  resumeUrl            String?
  learningAvailability String?
  preferredSchedule    String?
  courseInterest       String?
  campaignSource       String?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  consentGiven         Boolean                  @default(false)
  communicationPrefs   String?
  status               String                   @default("active")
  classification       CandidateClassification?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  // Corrected relations
  registrations         Registration[]
  assessments           Assessment[]
  enrollments           Enrollment[]
  leads                 Lead[]
  auditLogs             AuditLog[]
  placementApplications PlacementApplication[]
  expertMockInterviews  ExpertMockInterview[]
  projectReviews        CandidateProjectReview[]
  readinessReview       PlacementReadinessReview?

  @@index([candidateCode])
  @@index([email])
  @@index([phone])
  @@map("candidates")
}

model Registration {
  id                   String    @id @default(cuid())
  candidateId          String
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  education            String?
  graduationYear       Int?
  experienceYears      Int?
  currentEmployment    String?
  skills               String[]
  targetRole           String?
  codingPreference     String?
  resumeUrl            String?
  learningAvailability String?
  preferredSchedule    String?
  courseInterest       String?
  campaignSource       String?
  consentGiven         Boolean   @default(false)
  communicationPrefs   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([candidateId])
  @@map("registrations")
}

model Assessment {
  id              String           @id @default(cuid())
  candidateId     String
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            AssessmentType
  title           String
  description     String?
  score           Float?
  maxScore        Float            @default(100)
  classification  String?
  status          AssessmentStatus @default(IN_PROGRESS)
  responses       Json?
  roadmap         Json?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([candidateId])
  @@index([type])
  @@map("assessments")
}

model Lead {
  id             String     @id @default(cuid())
  leadCode       String     @unique
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String
  courseInterest String?
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  status         LeadStatus @default(NEW)
  ownerId        String?
  owner          User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes          String?
  consentGiven   Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("leads")
}

model AuditLog {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  candidateId String?
  action      String
  details     Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())
  Candidate   Candidate? @relation(fields: [candidateId], references: [id])

  @@index([userId])
  @@index([candidateId])
  @@index([action])
  @@map("audit_logs")
}

enum PlacementPipelineStage {
  PROFILE_REVIEW
  PREPARATION_PENDING
  JOB_READY
  RESUME_APPROVED
  JOBS_MATCHED
  SUBMITTED
  INTERVIEW_SCHEDULED
  FEEDBACK_AWAITED
  SELECTED
  OFFER_RECEIVED
  JOINED
}

enum PlacementApplicationStatus {
  DRAFT
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum PlacementInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PlacementInterviewOutcome {
  PENDING
  PASSED
  FAILED
  ON_HOLD
}

enum PlacementOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model PlacementApplication {
  id              String                     @id @default(cuid())
  candidateId     String
  candidate       Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyName     String
  jobTitle        String
  jobLocation     String?
  employmentType  String?
  jobDescription  String?                    @db.Text
  source          String?
  status          PlacementApplicationStatus @default(DRAFT)
  pipelineStage   PlacementPipelineStage     @default(PROFILE_REVIEW)
  appliedAt       DateTime?
  notes           String?                    @db.Text
  createdByUserId String?
  createdByUser   User?                      @relation("PlacementApplicationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  interviews      PlacementInterview[]
  offer           PlacementOffer?
  pipelineHistory PlacementPipelineHistory[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([candidateId, status])
  @@index([status, updatedAt])
  @@index([companyName])
  @@map("placement_applications")
}

model PlacementInterview {
  id            String                    @id @default(cuid())
  applicationId String
  application   PlacementApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round         Int                       @default(1)
  title         String?
  scheduledAt   DateTime
  durationMins  Int?
  mode          String?
  meetingLink   String?
  interviewer   String?
  status        PlacementInterviewStatus  @default(SCHEDULED)
  outcome       PlacementInterviewOutcome @default(PENDING)
  feedback      String?                   @db.Text
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([applicationId, scheduledAt])
  @@index([scheduledAt, status])
  @@map("placement_interviews")
}

model PlacementOffer {
  id            String               @id @default(cuid())
  applicationId String               @unique
  application   PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        PlacementOfferStatus @default(PENDING)
  compensation  Float?
  currency      String               @default("INR")
  offeredAt     DateTime?
  expiresAt     DateTime?
  joiningDate   DateTime?
  notes         String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, joiningDate])
  @@map("placement_offers")
}

enum ExpertMockInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CandidateProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  APPROVED
}

enum PlacementReadinessDecision {
  PENDING
  APPROVED
  NEEDS_WORK
}

model ExpertMockInterview {
  id           String                    @id @default(cuid())
  candidateId  String
  candidate    Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sequence     Int
  isFinal      Boolean                   @default(false)
  status       ExpertMockInterviewStatus @default(SCHEDULED)
  score        Float?
  maxScore     Float                     @default(10)
  reviewerName String?
  feedback     String?                   @db.Text
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([candidateId, sequence])
  @@index([candidateId, status])
  @@map("expert_mock_interviews")
}

model CandidateProjectReview {
  id             String                 @id @default(cuid())
  candidateId    String
  candidate      Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  projectName    String
  status         CandidateProjectStatus @default(NOT_STARTED)
  mentorFeedback String?                @db.Text
  expertApproved Boolean                @default(false)
  reviewerName   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([candidateId, status])
  @@map("candidate_project_reviews")
}

model PlacementReadinessReview {
  id               String                     @id @default(cuid())
  candidateId      String                     @unique
  candidate        Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  decision         PlacementReadinessDecision @default(PENDING)
  approvedByUserId String?
  notes            String?                    @db.Text
  reviewedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([decision, updatedAt])
  @@map("placement_readiness_reviews")
}

model HealthCheck {
  id        String   @id @default(cuid())
  service   String
  status    String
  checkedAt DateTime @default(now())

  @@map("health_checks")
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Course {
  id               String       @id @default(cuid())
  title            String
  category         String       @default("General")
  description      String       @db.Text
  duration         String
  level            CourseLevel
  price            Float        @default(0)
  learningOutcomes String[]
  status           CourseStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  modules     CourseModule[]
  enrollments Enrollment[]
  projects    Project[]

  @@index([status, level])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  content     String?      @db.Text
  videoUrl    String?
  duration    String?
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progress   LessonProgress[]
  assignment Assignment?

  @@unique([moduleId, sortOrder])
  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model PlacementPipelineHistory {
  id              String               @id @default(cuid())
  applicationId   String
  application     PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage       PlacementPipelineStage?
  toStage         PlacementPipelineStage
  note            String?               @db.Text
  changedByUserId String?
  createdAt       DateTime              @default(now())

  @@index([applicationId, createdAt])
  @@index([toStage, createdAt])
  @@map("placement_pipeline_history")
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

model Assignment {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String   @db.Text
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id             String                     @id @default(cuid())
  assignmentId   String
  assignment     Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  userId         String
  user           User                       @relation("AssignmentSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  submissionText String?                    @db.Text
  submissionUrl  String?
  status         AssignmentSubmissionStatus @default(SUBMITTED)
  feedback       String?                    @db.Text
  reviewerId     String?
  reviewer       User?                      @relation("AssignmentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  submittedAt    DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([assignmentId, userId, attemptNumber])
  @@index([userId, assignmentId])
  @@index([status, submittedAt])
  @@map("assignment_submissions")
}

enum ProjectSubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

model Project {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  businessProblem String   @db.Text
  expectedOutcome String   @db.Text
  resources       String?  @db.Text
  isRequired      Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  milestones ProjectMilestone[]

  @@unique([courseId, sortOrder])
  @@map("projects")
}

model ProjectMilestone {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?  @db.Text
  dueOffsetDays Int?
  sortOrder     Int      @default(0)
  isFinal       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submissions ProjectSubmission[]

  @@unique([projectId, sortOrder])
  @@map("project_milestones")
}

model ProjectSubmission {
  id             String                  @id @default(cuid())
  milestoneId    String
  milestone      ProjectMilestone        @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  userId         String
  user           User                    @relation("ProjectSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  submissionText String?                 @db.Text
  submissionUrl  String?
  status         ProjectSubmissionStatus @default(SUBMITTED)
  feedback       String?                 @db.Text
  vivaNotes      String?                 @db.Text
  reviewerId     String?
  reviewer       User?                   @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  submittedAt    DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([milestoneId, userId, attemptNumber])
  @@index([userId, milestoneId])
  @@index([status, submittedAt])
  @@map("project_submissions")
}
