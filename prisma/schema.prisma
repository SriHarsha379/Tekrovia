// =============================================================================
// TekRovia — Full Platform Prisma Schema
// Single source of truth. schema.sql is now archived reference only.
//
// Flow: Campaign → Lead → Candidate → Registration → Payment →
//       Batch → Activity → Assessment → Support → Placement
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  STUDENT
  TRAINER
  MENTOR
  ADMIN
  SUPER_ADMIN
  MARKETING
  SUPPORT
  PLACEMENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DROPPED
}

enum ChannelType {
  META
  GOOGLE
  YOUTUBE
  LINKEDIN
  ORGANIC
  REFERRAL
  OTHER
}

enum CandidateClassification {
  BEGINNER
  STARTER
  PRO
}

enum ProductCode {
  TECH_TRAINING
  INTERVIEW_PREP
  PLACEMENT_SUPPORT
  SOFT_SKILLS
  COMPLETE_PACKAGE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TrialSessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
}

enum AutomationTrigger {
  REGISTRATION
  AFTER_SESSION_1
  AFTER_SESSION_2
  AFTER_SESSION_3
  PLUS_24H
  PLUS_72H
  PLUS_7D
}

enum AutomationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum LessonType {
  VIDEO
  TRAINER_EXPLANATION
  LAB
  NOTES
  ASSIGNMENT
  QUIZ
  PRACTICAL
  INTERVIEW_QUESTIONS
  AI_DOUBT_ASSISTANT
}

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  SUBMITTED
  AI_REVIEWED
  MENTOR_APPROVED
  REJECTED
}

enum AssessmentType {
  FREE_ASSESSMENT
  CAREER_READINESS
  TECHNICAL
  AI_MOCK_DIAGNOSTIC
  MODULE_QUIZ
  FORMAL_READINESS
}

enum ReadinessClassification {
  JOB_READY
  TARGETED_BRUSHUP
  STRUCTURED_PREPARATION
}

enum MockType {
  AI_PRACTICE
  EXPERT_MOCK
}

enum GateStatus {
  PENDING
  QUALIFIED
  APPROVED_FOR_PLACEMENT
}

enum TicketCategory {
  LMS
  PAYMENT
  SCHEDULE
  TRAINER
  ASSIGNMENT
  PROJECT
  INTERVIEW
  RESUME
  MOCK
  PLACEMENT
  TECHNICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

enum SubmissionChannel {
  PORTAL
  HR
  DIRECT_VENDOR
  CLIENT
}

enum PipelineStage {
  PROFILE_REVIEW
  PREPARATION_PENDING
  JOB_READY
  RESUME_APPROVED
  JOBS_MATCHED
  SUBMITTED
  INTERVIEW_SCHEDULED
  FEEDBACK_AWAITED
  SELECTED
  OFFER_RECEIVED
  JOINED
}

enum RecoveryStatus {
  ACTIVE
  PAUSED_FOR_BRUSHUP
  RESUMED
  CLOSED
}

// =============================================================================
// SECTION 1 — AUTH & IDENTITY
// =============================================================================

/// Platform users — both candidates (STUDENT) and staff (TRAINER/ADMIN/etc.)
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  name         String
  passwordHash String?   @map("password_hash")
  role         UserRole  @default(STUDENT)
  isVerified   Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true)  @map("is_active")
  failedAttempts Int     @default(0)     @map("failed_attempts")
  lockedUntil  DateTime?                 @map("locked_until")
  lastLoginAt  DateTime?                 @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  // Relations
  candidate        Candidate?
  sessions         Session[]
  otpCodes         OtpCode[]
  auditLogs        AuditLog[]
  // Staff-side relations
  trainedBatches   Batch[]             @relation("BatchTrainer")
  enrollmentOwner  Enrollment[]        @relation("EnrollmentSupportOwner")
  mockInterviews   MockInterview[]     @relation("MockInterviewer")
  resumeReviews    Resume[]            @relation("ResumeReviewer")
  supportTickets   SupportTicket[]     @relation("TicketAssignee")
  ticketComments   TicketComment[]     @relation("StaffComments")
  jobPostings      JobPosting[]
  assessments      Assessment[]        @relation("AssessmentCreatedBy")
  mentoredSubs     ProjectSubmission[] @relation("ProjectMentor")
  priceList        PriceList[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  accessToken  String    @unique @map("access_token")
  refreshToken String    @unique @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessToken])
  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  purpose    String    @default("login")
  code       String                        // bcrypt hash — never plain text
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  meta       Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// =============================================================================
// SECTION 2 — MARKETING FUNNEL: CAMPAIGN → LEAD
// =============================================================================

model Campaign {
  id             String      @id @default(uuid())
  name           String
  channel        ChannelType
  targetAudience String?     @map("target_audience")
  utmSource      String?     @map("utm_source")
  utmMedium      String?     @map("utm_medium")
  utmCampaign    String?     @map("utm_campaign")
  utmContent     String?     @map("utm_content")
  utmTerm        String?     @map("utm_term")
  budget         Decimal?    @db.Decimal(12, 2)
  startDate      DateTime?   @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date")   @db.Date
  createdAt      DateTime    @default(now())    @map("created_at")
  updatedAt      DateTime    @updatedAt         @map("updated_at")

  leads         Lead[]
  registrations Registration[]
  funnelEvents  FunnelEvent[]

  @@map("campaigns")
}

model Lead {
  id              String     @id @default(uuid())
  leadCode        String     @unique @map("lead_code")
  campaignId      String?    @map("campaign_id")
  name            String
  // At least one of email/phone must be set — enforced at app layer + DB check
  email           String?
  phone           String?
  landingPageUrl  String?    @map("landing_page_url")
  status          LeadStatus @default(NEW)
  courseInterest  String?    @map("course_interest")
  source          String?
  utmSource       String?    @map("utm_source")
  utmMedium       String?    @map("utm_medium")
  utmCampaign     String?    @map("utm_campaign")
  utmContent      String?    @map("utm_content")
  utmTerm         String?    @map("utm_term")
  consentGiven    Boolean    @default(false) @map("consent_given")
  metadata        Json?
  candidateId     String?    @map("candidate_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt      @map("updated_at")

  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  funnelEvents FunnelEvent[]

  @@index([campaignId])
  @@index([email])
  @@index([phone])
  @@map("leads")
}

/// Append-only funnel event log for the marketing dashboard
model FunnelEvent {
  id          String   @id @default(uuid())
  leadId      String?  @map("lead_id")
  candidateId String?  @map("candidate_id")
  campaignId  String?  @map("campaign_id")
  // e.g. visit | registration | assessment_start | checkout_start | enrollment
  eventType   String   @map("event_type")
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")

  lead      Lead?      @relation(fields: [leadId],      references: [id], onDelete: SetNull)
  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  campaign  Campaign?  @relation(fields: [campaignId],  references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([leadId])
  @@index([candidateId])
  @@map("funnel_events")
}

// =============================================================================
// SECTION 3 — CANDIDATE & REGISTRATION
// =============================================================================

model Candidate {
  id                String                   @id @default(uuid())
  candidateCode     String                   @unique @map("candidate_code")
  userId            String                   @unique @map("user_id")
  fullName          String                   @map("full_name")
  email             String                   @unique
  phone             String                   @unique
  classification    CandidateClassification?
  education         String?
  graduationYear    Int?                     @map("graduation_year")
  experienceYears   Int                      @default(0) @map("experience_years")
  skills            String[]
  targetRole        String?                  @map("target_role")
  codingPreference  String?                  @map("coding_preference")
  resumeUrl         String?                  @map("resume_url")
  previousTraining  String?                  @map("previous_training")
  careerGapMonths   Int                      @default(0) @map("career_gap_months")
  learningAvailability String?               @map("learning_availability")
  preferredSchedule String?                  @map("preferred_schedule")
  courseInterest    String?                  @map("course_interest")
  campaignSource    String?                  @map("campaign_source")
  utmSource         String?                  @map("utm_source")
  utmMedium         String?                  @map("utm_medium")
  utmCampaign       String?                  @map("utm_campaign")
  utmContent        String?                  @map("utm_content")
  utmTerm           String?                  @map("utm_term")
  consentGiven      Boolean                  @default(false) @map("consent_given")
  communicationPrefs String?                 @map("communication_prefs")
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt      @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads              Lead[]
  registrations      Registration[]
  assessments        Assessment[]
  enrollments        Enrollment[]
  activities         Activity[]
  assignmentSubs     AssignmentSubmission[]
  projectSubs        ProjectSubmission[]
  mockInterviews     MockInterview[]
  resumes            Resume[]
  readinessGates     ReadinessGate[]
  supportTickets     SupportTicket[]
  ticketComments     TicketComment[]     @relation("CandidateComments")
  jobMatches         JobMatch[]
  placementSubs      PlacementSubmission[]
  placementRecovery  PlacementRecovery[]
  trialProgress      TrialProgress[]
  automationEvents   AutomationEvent[]
  funnelEvents       FunnelEvent[]
  payments           Payment[]

  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("candidates")
}

model Registration {
  id                 String    @id @default(uuid())
  candidateId        String    @map("candidate_id")
  campaignSourceId   String?   @map("campaign_source_id")
  education          String?
  graduationYear     Int?      @map("graduation_year")
  experienceYears    Decimal?  @map("experience_years") @db.Decimal(4, 1)
  currentSkills      String[]  @map("current_skills")
  earlierTraining    String?   @map("earlier_training")
  careerGapMonths    Int?      @map("career_gap_months")
  targetRole         String?   @map("target_role")
  codingPreference   String?   @map("coding_preference")
  resumeUrl          String?   @map("resume_url")
  learningAvailability String? @map("learning_availability")
  chosenSchedule     String?   @map("chosen_schedule")
  createdAt          DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignSourceId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@map("registrations")
}

// =============================================================================
// SECTION 4 — PRODUCTS & PRICING
// =============================================================================

model Product {
  id          String      @id @default(uuid())
  code        ProductCode @unique
  name        String
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  priceList    PriceList[]
  paymentItems PaymentItem[]
  enrollments  Enrollment[]
  batches      Batch[]
  courses      Course[]

  @@map("products")
}

/// Versioned pricing — allows price changes without schema migrations
model PriceList {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  amount     Decimal   @db.Decimal(10, 2)
  currency   String    @default("INR")
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")  // NULL = currently active
  createdById String?  @map("created_by_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  product   Product @relation(fields: [productId],   references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, validFrom(sort: Desc)])
  @@map("price_list")
}

// =============================================================================
// SECTION 5 — PAYMENTS
// =============================================================================

model Payment {
  id                String        @id @default(uuid())
  candidateId       String        @map("candidate_id")
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  // Note: razorpay_signature is NOT stored — verify on receipt and discard
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  invoiceNumber     String?       @unique @map("invoice_number")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt      @map("updated_at")
  paidAt            DateTime?     @map("paid_at")

  candidate     Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  items         PaymentItem[]
  enrollments   Enrollment[]
  paymentEvents PaymentEvent[]

  @@index([candidateId])
  @@map("payments")
}

model PaymentItem {
  id              String  @id @default(uuid())
  paymentId       String  @map("payment_id")
  productId       String  @map("product_id")
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("payment_items")
}

/// Webhook event log — raw payload stored; signature verified on receipt and NOT stored
model PaymentEvent {
  id             String   @id @default(uuid())
  paymentId      String?  @map("payment_id")
  eventType      String   @map("event_type")
  razorpayEvent  Json?    @map("razorpay_event")
  processedAt    DateTime @default(now()) @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

// =============================================================================
// SECTION 6 — BATCHES, ENROLLMENTS & TRIAL FLOW
// =============================================================================

model Batch {
  id        String      @id @default(uuid())
  name      String
  productId String      @map("product_id")
  trainerId String?     @map("trainer_id")
  capacity  Int         @default(15)
  startDate DateTime?   @map("start_date") @db.Date
  endDate   DateTime?   @map("end_date")   @db.Date
  status    BatchStatus @default(PLANNED)
  createdAt DateTime    @default(now())    @map("created_at")
  updatedAt DateTime    @updatedAt         @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id])
  trainer     User?        @relation("BatchTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@index([productId])
  @@map("batches")
}

model Enrollment {
  id             String           @id @default(uuid())
  candidateId    String           @map("candidate_id")
  productId      String           @map("product_id")
  paymentId      String?          @map("payment_id")
  batchId        String?          @map("batch_id")
  supportOwnerId String?          @map("support_owner_id")
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @map("enrolled_at")
  updatedAt      DateTime         @updatedAt      @map("updated_at")

  candidate    Candidate @relation(fields: [candidateId],    references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId],      references: [id])
  payment      Payment?  @relation(fields: [paymentId],      references: [id])
  batch        Batch?    @relation(fields: [batchId],        references: [id], onDelete: SetNull)
  supportOwner User?     @relation("EnrollmentSupportOwner", fields: [supportOwnerId], references: [id], onDelete: SetNull)

  @@unique([candidateId, productId])
  @@index([candidateId])
  @@index([batchId])
  @@map("enrollments")
}

/// Pre-purchase 3-session GenAI trial
model TrialProgress {
  id           String             @id @default(uuid())
  candidateId  String             @map("candidate_id")
  sessionNumber Int               @map("session_number")
  status       TrialSessionStatus @default(SCHEDULED)
  labCompleted Boolean            @default(false) @map("lab_completed")
  scheduledAt  DateTime?          @map("scheduled_at")
  completedAt  DateTime?          @map("completed_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, sessionNumber])
  @@map("trial_progress")
}

model AutomationEvent {
  id          String            @id @default(uuid())
  candidateId String            @map("candidate_id")
  triggerType AutomationTrigger @map("trigger_type")
  channel     AutomationChannel
  status      String            @default("sent")  // sent | failed | skipped
  payload     Json?
  sentAt      DateTime          @default(now()) @map("sent_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("automation_events")
}

// =============================================================================
// SECTION 7 — LMS: COURSES → MODULES → LESSONS → ACTIVITY
// =============================================================================

model Course {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  title       String
  description String?

  product  Product    @relation(fields: [productId], references: [id])
  modules  Module[]
  projects Project[]

  @@map("courses")
}

model Module {
  id          String  @id @default(uuid())
  courseId    String  @map("course_id")
  title       String
  orderIndex  Int     @map("order_index")
  // e.g. { "requires_module_id": "...", "min_score": 70 }
  unlockRule  Json?   @map("unlock_rule")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assessments Assessment[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id           String     @id @default(uuid())
  moduleId     String     @map("module_id")
  title        String
  type         LessonType
  orderIndex   Int        @map("order_index")
  videoAssetId String?    @map("video_asset_id")  // Mux / Cloudflare Stream
  content      String?

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  activities  Activity[]
  assignments Assignment[]

  @@index([moduleId])
  @@map("lessons")
}

model Activity {
  id          String         @id @default(uuid())
  candidateId String         @map("candidate_id")
  lessonId    String         @map("lesson_id")
  status      ActivityStatus @default(NOT_STARTED)
  score       Decimal?       @db.Decimal(5, 2)
  completedAt DateTime?      @map("completed_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  lesson    Lesson    @relation(fields: [lessonId],    references: [id], onDelete: Cascade)

  @@unique([candidateId, lessonId])
  @@index([candidateId])
  @@map("activities")
}

model Assignment {
  id              String  @id @default(uuid())
  lessonId        String? @map("lesson_id")
  title           String
  instructions    String?
  dueDateOffsetDays Int?  @map("due_date_offset_days")

  lesson      Lesson?               @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String           @map("assignment_id")
  candidateId  String           @map("candidate_id")
  submissionUrl String?         @map("submission_url")
  status       SubmissionStatus @default(SUBMITTED)
  score        Decimal?         @db.Decimal(5, 2)
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  reviewedAt   DateTime?        @map("reviewed_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  candidate  Candidate  @relation(fields: [candidateId],  references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("assignment_submissions")
}

// =============================================================================
// SECTION 8 — PROJECTS
// =============================================================================

model Project {
  id              String  @id @default(uuid())
  courseId        String  @map("course_id")
  title           String
  businessProblem String? @map("business_problem")
  expectedOutcome String? @map("expected_outcome")
  milestones      Json?

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]

  @@map("projects")
}

model ProjectSubmission {
  id                   String           @id @default(uuid())
  projectId            String           @map("project_id")
  candidateId          String           @map("candidate_id")
  submissionUrl        String?          @map("submission_url")
  aiReviewFeedback     String?          @map("ai_review_feedback")
  aiReviewScore        Decimal?         @map("ai_review_score") @db.Decimal(5, 2)
  mentorId             String?          @map("mentor_id")
  mentorFeedback       String?          @map("mentor_feedback")
  status               SubmissionStatus @default(SUBMITTED)
  finalPresentationAt  DateTime?        @map("final_presentation_at")
  submittedAt          DateTime         @default(now()) @map("submitted_at")
  reviewedAt           DateTime?        @map("reviewed_at")

  project   Project   @relation(fields: [projectId],   references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  mentor    User?     @relation("ProjectMentor", fields: [mentorId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@map("project_submissions")
}

// =============================================================================
// SECTION 9 — ASSESSMENTS
// =============================================================================

model Assessment {
  id              String         @id @default(uuid())
  candidateId     String         @map("candidate_id")
  createdByUserId String?        @map("created_by_user_id")
  relatedModuleId String?        @map("related_module_id")
  type            AssessmentType
  title           String
  description     String?
  score           Decimal?       @db.Decimal(5, 2)
  maxScore        Decimal?       @map("max_score") @db.Decimal(5, 2)
  // e.g. { "theory": 4, "logical": 5, "practical": 3 }
  responses       Json?
  roadmap         Json?
  classification  String?
  status          String         @default("PENDING")
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt      @map("updated_at")

  candidate     Candidate @relation(fields: [candidateId],     references: [id], onDelete: Cascade)
  createdByUser User?     @relation("AssessmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  module        Module?   @relation(fields: [relatedModuleId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@map("assessments")
}

// =============================================================================
// SECTION 10 — INTERVIEW READINESS
// =============================================================================

model MockInterview {
  id           String   @id @default(uuid())
  candidateId  String   @map("candidate_id")
  type         MockType
  mockNumber   Int?     @map("mock_number")     // 1,2,3 for expert; null for AI
  interviewerId String? @map("interviewer_id")
  isFinalMock  Boolean  @default(false) @map("is_final_mock")
  score        Decimal? @db.Decimal(5, 2)
  feedback     String?
  conductedAt  DateTime @default(now()) @map("conducted_at")

  candidate     Candidate        @relation(fields: [candidateId],  references: [id], onDelete: Cascade)
  interviewer   User?            @relation("MockInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  placementRecovery PlacementRecovery[]

  @@index([candidateId])
  @@map("mock_interviews")
}

model Resume {
  id          String   @id @default(uuid())
  candidateId String   @map("candidate_id")
  fileUrl     String   @map("file_url")
  version     Int      @default(1)
  atsScore    Decimal? @map("ats_score") @db.Decimal(5, 2)
  reviewedById String? @map("reviewed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate  Candidate @relation(fields: [candidateId],  references: [id], onDelete: Cascade)
  reviewedBy User?     @relation("ResumeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@map("resumes")
}

/// Snapshot table: re-evaluated each time projects/mocks/scores change
/// Projects complete + 3 mocks complete + score ≥8/10 + final mock ≥8/10
model ReadinessGate {
  id               String     @id @default(uuid())
  candidateId      String     @map("candidate_id")
  projectsComplete Boolean    @default(false) @map("projects_complete")
  mocksComplete    Boolean    @default(false) @map("mocks_complete")
  formalScore      Decimal?   @map("formal_score")  @db.Decimal(4, 2)
  finalMockScore   Decimal?   @map("final_mock_score") @db.Decimal(4, 2)
  status           GateStatus @default(PENDING)
  evaluatedAt      DateTime   @default(now()) @map("evaluated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("readiness_gates")
}

// =============================================================================
// SECTION 11 — SUPPORT & TICKETING
// =============================================================================

model SupportTicket {
  id          String         @id @default(uuid())
  candidateId String         @map("candidate_id")
  category    TicketCategory
  subject     String
  description String?
  status      TicketStatus   @default(OPEN)
  assignedToId String?       @map("assigned_to_id")
  slaDueAt    DateTime?      @map("sla_due_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt      @map("updated_at")
  resolvedAt  DateTime?      @map("resolved_at")

  candidate  Candidate       @relation(fields: [candidateId],  references: [id], onDelete: Cascade)
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments   TicketComment[]

  @@index([candidateId])
  @@index([status])
  @@map("support_tickets")
}

/// Either authorUserId OR authorCandidateId must be set — never both, never neither
model TicketComment {
  id                 String   @id @default(uuid())
  ticketId           String   @map("ticket_id")
  authorUserId       String?  @map("author_user_id")
  authorCandidateId  String?  @map("author_candidate_id")
  message            String
  createdAt          DateTime @default(now()) @map("created_at")

  ticket          SupportTicket @relation(fields: [ticketId],          references: [id], onDelete: Cascade)
  authorUser      User?         @relation("StaffComments",     fields: [authorUserId],      references: [id], onDelete: SetNull)
  authorCandidate Candidate?    @relation("CandidateComments", fields: [authorCandidateId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("ticket_comments")
}

// =============================================================================
// SECTION 12 — PLACEMENT OPERATIONS
// =============================================================================

model JobPosting {
  id             String   @id @default(uuid())
  clientName     String   @map("client_name")
  roleTitle      String   @map("role_title")
  jobDescription String?  @map("job_description")
  jobLink        String?  @map("job_link")
  location       String?
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  matches   JobMatch[]
  submissions PlacementSubmission[]

  @@map("job_postings")
}

model JobMatch {
  id            String   @id @default(uuid())
  candidateId   String   @map("candidate_id")
  jobPostingId  String   @map("job_posting_id")
  // Which resume/project/skill lines matched the JD
  matchEvidence Json?    @map("match_evidence")
  createdAt     DateTime @default(now()) @map("created_at")

  candidate  Candidate  @relation(fields: [candidateId],  references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobPostingId])
  @@map("job_matches")
}

model PlacementSubmission {
  id           String            @id @default(uuid())
  candidateId  String            @map("candidate_id")
  jobPostingId String?           @map("job_posting_id")
  stage        PipelineStage     @default(PROFILE_REVIEW)
  channel      SubmissionChannel?
  blocker      String?
  nextAction   String?           @map("next_action")
  rejectionReason String?        @map("rejection_reason")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt      @map("updated_at")

  candidate        Candidate        @relation(fields: [candidateId],  references: [id], onDelete: Cascade)
  jobPosting       JobPosting?      @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  interviewRounds  InterviewRound[]

  @@index([candidateId])
  @@index([stage])
  @@map("placement_submissions")
}

model InterviewRound {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  roundNumber  Int      @map("round_number")
  scheduledAt  DateTime? @map("scheduled_at")
  // pending | cleared | rejected
  outcome      String?
  feedback     String?

  submission PlacementSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("interview_rounds")
}

/// Four-interview recovery rule tracking
model PlacementRecovery {
  id              String         @id @default(uuid())
  candidateId     String         @map("candidate_id")
  rejectionCount  Int            @default(0) @map("rejection_count")
  pausedAt        DateTime?      @map("paused_at")
  brushupStart    DateTime?      @map("brushup_start") @db.Date
  brushupEnd      DateTime?      @map("brushup_end")   @db.Date
  repeatMockId    String?        @map("repeat_mock_id")
  resumedAt       DateTime?      @map("resumed_at")
  status          RecoveryStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt      @map("updated_at")

  candidate   Candidate     @relation(fields: [candidateId],  references: [id], onDelete: Cascade)
  repeatMock  MockInterview? @relation(fields: [repeatMockId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@map("placement_recovery")
}
