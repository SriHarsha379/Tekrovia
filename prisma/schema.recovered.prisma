generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model assessments {
  id              String           @id
  candidateId     String
  createdByUserId String?
  type            AssessmentType
  title           String
  description     String?
  score           Float?
  maxScore        Float            @default(100)
  classification  String?
  status          AssessmentStatus @default(IN_PROGRESS)
  responses       Json?
  roadmap         Json?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  candidates      candidates       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  users           users?           @relation(fields: [createdByUserId], references: [id])

  @@index([candidateId])
  @@index([type])
}

model assignment_submissions {
  id                                             String                     @id
  assignmentId                                   String
  userId                                         String
  attemptNumber                                  Int
  submissionText                                 String?
  submissionUrl                                  String?
  status                                         AssignmentSubmissionStatus @default(SUBMITTED)
  feedback                                       String?
  reviewerId                                     String?
  reviewedAt                                     DateTime?
  submittedAt                                    DateTime                   @default(now())
  updatedAt                                      DateTime
  assignments                                    assignments                @relation(fields: [assignmentId], references: [id])
  users_assignment_submissions_reviewerIdTousers users?                     @relation("assignment_submissions_reviewerIdTousers", fields: [reviewerId], references: [id])
  users_assignment_submissions_userIdTousers     users                      @relation("assignment_submissions_userIdTousers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId, attemptNumber])
  @@index([status, submittedAt])
  @@index([userId, assignmentId])
}

model assignments {
  id                     String                   @id
  lessonId               String                   @unique
  title                  String
  instructions           String
  isRequired             Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  assignment_submissions assignment_submissions[]
  lessons                lessons                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model audit_logs {
  id          String      @id
  userId      String?
  candidateId String?
  action      String
  details     Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())
  candidates  candidates? @relation(fields: [candidateId], references: [id])
  users       users?      @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([candidateId])
  @@index([userId])
}

model candidate_project_reviews {
  id             String                 @id
  candidateId    String
  projectName    String
  status         CandidateProjectStatus @default(NOT_STARTED)
  mentorFeedback String?
  expertApproved Boolean                @default(false)
  reviewerName   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime
  candidates     candidates             @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, status])
}

model candidates {
  id                          String                       @id
  candidateCode               String                       @unique
  userId                      String                       @unique
  fullName                    String
  email                       String                       @unique
  phone                       String                       @unique
  education                   String?
  graduationYear              Int?
  experienceYears             Int                          @default(0)
  currentEmployment           String?
  skills                      String[]
  previousTraining            String?
  careerGapMonths             Int                          @default(0)
  targetRole                  String?
  codingPreference            String?
  resumeUrl                   String?
  learningAvailability        String?
  preferredSchedule           String?
  courseInterest              String?
  campaignSource              String?
  utmSource                   String?
  utmMedium                   String?
  utmCampaign                 String?
  utmContent                  String?
  utmTerm                     String?
  consentGiven                Boolean                      @default(false)
  communicationPrefs          String?
  status                      String                       @default("active")
  classification              CandidateClassification?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime
  assessments                 assessments[]
  audit_logs                  audit_logs[]
  candidate_project_reviews   candidate_project_reviews[]
  users                       users                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments                 enrollments[]
  expert_mock_interviews      expert_mock_interviews[]
  leads                       leads[]
  placement_applications      placement_applications[]
  placement_readiness_reviews placement_readiness_reviews?
  registrations               registrations?

  @@index([candidateCode])
  @@index([email])
  @@index([phone])
}

model course_modules {
  id          String    @id
  courseId    String
  title       String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  courses     courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     lessons[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
}

model courses {
  id               String           @id
  title            String
  description      String
  duration         String
  level            CourseLevel
  price            Float            @default(0)
  learningOutcomes String[]
  status           CourseStatus     @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  category         String           @default("General")
  course_modules   course_modules[]
  enrollments      enrollments[]
  projects         projects[]

  @@index([status, level])
}

model enrollments {
  id          String           @id
  userId      String
  candidateId String?
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime
  candidates  candidates?      @relation(fields: [candidateId], references: [id])
  courses     courses          @relation(fields: [courseId], references: [id])
  users       users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, status])
}

model expert_mock_interviews {
  id           String                    @id
  candidateId  String
  sequence     Int
  isFinal      Boolean                   @default(false)
  status       ExpertMockInterviewStatus @default(SCHEDULED)
  score        Float?
  maxScore     Float                     @default(10)
  reviewerName String?
  feedback     String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime
  candidates   candidates                @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, sequence])
  @@index([candidateId, status])
}

model health_checks {
  id        String   @id
  service   String
  status    String
  checkedAt DateTime @default(now())
}

model leads {
  id             String      @id
  leadCode       String      @unique
  candidateId    String?
  name           String
  email          String
  phone          String
  courseInterest String?
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  status         LeadStatus  @default(NEW)
  ownerId        String?
  notes          String?
  consentGiven   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  candidates     candidates? @relation(fields: [candidateId], references: [id])
  users          users?      @relation(fields: [ownerId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([status])
}

model lesson_progress {
  id          String    @id
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime
  lessons     lessons   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model lessons {
  id              String            @id
  moduleId        String
  title           String
  description     String?
  content         String?
  videoUrl        String?
  duration        String?
  sortOrder       Int               @default(0)
  isPublished     Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  assignments     assignments?
  lesson_progress lesson_progress[]
  course_modules  course_modules    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sortOrder])
  @@index([moduleId])
}

model otp_codes {
  id         String    @id
  userId     String
  purpose    String    @default("login")
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose])
  @@index([userId])
}

model placement_applications {
  id                         String                       @id
  candidateId                String
  companyName                String
  jobTitle                   String
  jobLocation                String?
  employmentType             String?
  jobDescription             String?
  source                     String?
  status                     PlacementApplicationStatus   @default(DRAFT)
  appliedAt                  DateTime?
  notes                      String?
  createdByUserId            String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  pipelineStage              PlacementPipelineStage       @default(PROFILE_REVIEW)
  candidates                 candidates                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  users                      users?                       @relation(fields: [createdByUserId], references: [id])
  placement_interviews       placement_interviews[]
  placement_offers           placement_offers?
  placement_pipeline_history placement_pipeline_history[]

  @@index([candidateId, status])
  @@index([companyName])
  @@index([status, updatedAt])
}

model placement_interviews {
  id                     String                    @id
  applicationId          String
  round                  Int                       @default(1)
  title                  String?
  scheduledAt            DateTime
  durationMins           Int?
  mode                   String?
  meetingLink            String?
  interviewer            String?
  status                 PlacementInterviewStatus  @default(SCHEDULED)
  outcome                PlacementInterviewOutcome @default(PENDING)
  feedback               String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime
  placement_applications placement_applications    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, scheduledAt])
  @@index([scheduledAt, status])
}

model placement_offers {
  id                     String                 @id
  applicationId          String                 @unique
  status                 PlacementOfferStatus   @default(PENDING)
  compensation           Float?
  currency               String                 @default("INR")
  offeredAt              DateTime?
  expiresAt              DateTime?
  joiningDate            DateTime?
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  placement_applications placement_applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([status, joiningDate])
}

model placement_pipeline_history {
  id                     String                  @id
  applicationId          String
  fromStage              PlacementPipelineStage?
  toStage                PlacementPipelineStage
  note                   String?
  changedByUserId        String?
  createdAt              DateTime                @default(now())
  placement_applications placement_applications  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([toStage, createdAt])
}

model placement_readiness_reviews {
  id               String                     @id
  candidateId      String                     @unique
  decision         PlacementReadinessDecision @default(PENDING)
  approvedByUserId String?
  notes            String?
  reviewedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime
  candidates       candidates                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([decision, updatedAt])
}

model project_milestones {
  id                  String                @id
  projectId           String
  title               String
  description         String?
  dueOffsetDays       Int?
  sortOrder           Int                   @default(0)
  isFinal             Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  projects            projects              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  project_submissions project_submissions[]

  @@unique([projectId, sortOrder])
}

model project_submissions {
  id                                          String                  @id
  milestoneId                                 String
  userId                                      String
  attemptNumber                               Int
  submissionText                              String?
  submissionUrl                               String?
  status                                      ProjectSubmissionStatus @default(SUBMITTED)
  feedback                                    String?
  vivaNotes                                   String?
  reviewerId                                  String?
  reviewedAt                                  DateTime?
  submittedAt                                 DateTime                @default(now())
  updatedAt                                   DateTime
  project_milestones                          project_milestones      @relation(fields: [milestoneId], references: [id])
  users_project_submissions_reviewerIdTousers users?                  @relation("project_submissions_reviewerIdTousers", fields: [reviewerId], references: [id])
  users_project_submissions_userIdTousers     users                   @relation("project_submissions_userIdTousers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, userId, attemptNumber])
  @@index([status, submittedAt])
  @@index([userId, milestoneId])
}

model projects {
  id                 String               @id
  courseId           String
  title              String
  businessProblem    String
  expectedOutcome    String
  resources          String?
  isRequired         Boolean              @default(true)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  project_milestones project_milestones[]
  courses            courses              @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sortOrder])
}

model registrations {
  id                   String     @id
  candidateId          String     @unique
  education            String?
  graduationYear       Int?
  experienceYears      Int?
  currentEmployment    String?
  skills               String[]
  targetRole           String?
  codingPreference     String?
  resumeUrl            String?
  learningAvailability String?
  preferredSchedule    String?
  courseInterest       String?
  campaignSource       String?
  consentGiven         Boolean    @default(false)
  communicationPrefs   String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime
  candidates           candidates @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model sessions {
  id           String    @id
  userId       String
  accessToken  String    @unique
  refreshToken String    @unique
  deviceInfo   String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  users        users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model users {
  id                                                              String                   @id
  email                                                           String                   @unique
  phone                                                           String                   @unique
  name                                                            String
  passwordHash                                                    String?
  role                                                            UserRole                 @default(STUDENT)
  isVerified                                                      Boolean                  @default(false)
  isActive                                                        Boolean                  @default(true)
  createdAt                                                       DateTime                 @default(now())
  updatedAt                                                       DateTime
  assessments                                                     assessments[]
  assignment_submissions_assignment_submissions_reviewerIdTousers assignment_submissions[] @relation("assignment_submissions_reviewerIdTousers")
  assignment_submissions_assignment_submissions_userIdTousers     assignment_submissions[] @relation("assignment_submissions_userIdTousers")
  audit_logs                                                      audit_logs[]
  candidates                                                      candidates?
  enrollments                                                     enrollments[]
  leads                                                           leads[]
  lesson_progress                                                 lesson_progress[]
  otp_codes                                                       otp_codes[]
  placement_applications                                          placement_applications[]
  project_submissions_project_submissions_reviewerIdTousers       project_submissions[]    @relation("project_submissions_reviewerIdTousers")
  project_submissions_project_submissions_userIdTousers           project_submissions[]    @relation("project_submissions_userIdTousers")
  sessions                                                        sessions[]
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum AssessmentType {
  FREE_ASSESSMENT
  CAREER_READINESS
  TECHNICAL
  MOCK_INTERVIEW
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum CandidateClassification {
  BEGINNER
  STARTER
  PRO
}

enum CandidateProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVISION
  APPROVED
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExpertMockInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  PROSPECT
  PIPELINE
  PENDING_CLOSURE
  ENROLLED
  DROPPED
}

enum PlacementApplicationStatus {
  DRAFT
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum PlacementInterviewOutcome {
  PENDING
  PASSED
  FAILED
  ON_HOLD
}

enum PlacementInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PlacementOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum PlacementPipelineStage {
  PROFILE_REVIEW
  PREPARATION_PENDING
  JOB_READY
  RESUME_APPROVED
  JOBS_MATCHED
  SUBMITTED
  INTERVIEW_SCHEDULED
  FEEDBACK_AWAITED
  SELECTED
  OFFER_RECEIVED
  JOINED
}

enum PlacementReadinessDecision {
  PENDING
  APPROVED
  NEEDS_WORK
}

enum ProjectSubmissionStatus {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum UserRole {
  STUDENT
  TRAINER
  COUNSELLOR
  SUPPORT_STAFF
  PLACEMENT_MANAGER
  RECRUITER
  ADMIN
  SUPER_ADMIN
}
