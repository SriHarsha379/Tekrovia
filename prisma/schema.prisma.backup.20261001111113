generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TRAINER
  COUNSELLOR
  SUPPORT_STAFF
  PLACEMENT_MANAGER
  RECRUITER
  ADMIN
  SUPER_ADMIN
}

enum CandidateClassification {
  BEGINNER
  STARTER
  PRO
}

enum AssessmentType {
  FREE_ASSESSMENT
  CAREER_READINESS
  TECHNICAL
  MOCK_INTERVIEW
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  PROSPECT
  PIPELINE
  PENDING_CLOSURE
  ENROLLED
  DROPPED
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(STUDENT)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate   Candidate?
  sessions    Session[]
  otpCodes    OtpCode[]
  leadsOwned  Lead[]       @relation("LeadOwner")
  assessments Assessment[]
  enrollments  Enrollment[]
  lessonProgress LessonProgress[]
  auditLogs   AuditLog[]
  placementApplicationsCreated PlacementApplication[] @relation("PlacementApplicationCreator")

  @@map("users")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String    @unique
  refreshToken String    @unique
  deviceInfo   String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String    @default("login")
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([purpose])
  @@map("otp_codes")
}

model Candidate {
  id                   String                   @id @default(cuid())
  candidateCode        String                   @unique
  userId               String                   @unique
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  email                String                   @unique
  phone                String                   @unique
  education            String?
  graduationYear       Int?
  experienceYears      Int                      @default(0)
  currentEmployment    String?
  skills               String[]
  previousTraining     String?
  careerGapMonths      Int                      @default(0)
  targetRole           String?
  codingPreference     String?
  resumeUrl            String?
  learningAvailability String?
  preferredSchedule    String?
  courseInterest       String?
  campaignSource       String?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  utmTerm              String?
  consentGiven         Boolean                  @default(false)
  communicationPrefs   String?
  status               String                   @default("active")
  classification       CandidateClassification?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  // Corrected relations
  registrations Registration[]
  assessments   Assessment[]
  enrollments   Enrollment[]
  leads         Lead[]
  auditLogs     AuditLog[]
  placementApplications PlacementApplication[]

  @@index([candidateCode])
  @@index([email])
  @@index([phone])
  @@map("candidates")
}

model Registration {
  id                   String    @id @default(cuid())
  candidateId          String
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  education            String?
  graduationYear       Int?
  experienceYears      Int?
  currentEmployment    String?
  skills               String[]
  targetRole           String?
  codingPreference     String?
  resumeUrl            String?
  learningAvailability String?
  preferredSchedule    String?
  courseInterest       String?
  campaignSource       String?
  consentGiven         Boolean   @default(false)
  communicationPrefs   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([candidateId])
  @@map("registrations")
}

model Assessment {
  id              String           @id @default(cuid())
  candidateId     String
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  type            AssessmentType
  title           String
  description     String?
  score           Float?
  maxScore        Float            @default(100)
  classification  String?
  status          AssessmentStatus @default(IN_PROGRESS)
  responses       Json?
  roadmap         Json?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([candidateId])
  @@index([type])
  @@map("assessments")
}

model Lead {
  id             String     @id @default(cuid())
  leadCode       String     @unique
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String
  courseInterest String?
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  status         LeadStatus @default(NEW)
  ownerId        String?
  owner          User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes          String?
  consentGiven   Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("leads")
}

model AuditLog {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  candidateId String?
  action      String
  details     Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())
  Candidate   Candidate? @relation(fields: [candidateId], references: [id])

  @@index([userId])
  @@index([candidateId])
  @@index([action])
  @@map("audit_logs")
}


enum PlacementApplicationStatus {
  DRAFT
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum PlacementInterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PlacementInterviewOutcome {
  PENDING
  PASSED
  FAILED
  ON_HOLD
}

enum PlacementOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model PlacementApplication {
  id              String                     @id @default(cuid())
  candidateId     String
  candidate       Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyName     String
  jobTitle        String
  jobLocation     String?
  employmentType  String?
  jobDescription  String?                    @db.Text
  source          String?
  status          PlacementApplicationStatus @default(DRAFT)
  appliedAt       DateTime?
  notes           String?                    @db.Text
  createdByUserId String?
  createdByUser   User?                      @relation("PlacementApplicationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  interviews      PlacementInterview[]
  offer           PlacementOffer?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([candidateId, status])
  @@index([status, updatedAt])
  @@index([companyName])
  @@map("placement_applications")
}

model PlacementInterview {
  id            String                    @id @default(cuid())
  applicationId String
  application   PlacementApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round         Int                       @default(1)
  title         String?
  scheduledAt   DateTime
  durationMins  Int?
  mode          String?
  meetingLink   String?
  interviewer   String?
  status        PlacementInterviewStatus  @default(SCHEDULED)
  outcome       PlacementInterviewOutcome @default(PENDING)
  feedback      String?                   @db.Text
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([applicationId, scheduledAt])
  @@index([scheduledAt, status])
  @@map("placement_interviews")
}

model PlacementOffer {
  id              String               @id @default(cuid())
  applicationId   String               @unique
  application     PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status          PlacementOfferStatus  @default(PENDING)
  compensation    Float?
  currency        String               @default("INR")
  offeredAt       DateTime?
  expiresAt       DateTime?
  joiningDate     DateTime?
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, joiningDate])
  @@map("placement_offers")
}

model HealthCheck {
  id        String   @id @default(cuid())
  service   String
  status    String
  checkedAt DateTime @default(now())

  @@map("health_checks")
}


enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Course {
  id               String       @id @default(cuid())
  title            String
  category         String       @default("General")
  description      String       @db.Text
  duration         String
  level            CourseLevel
  price            Float        @default(0)
  learningOutcomes String[]
  status           CourseStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  modules     CourseModule[]
  enrollments Enrollment[]

  @@index([status, level])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  content     String?      @db.Text
  videoUrl    String?
  duration    String?
  sortOrder   Int          @default(0)
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progress LessonProgress[]

  @@unique([moduleId, sortOrder])
  @@index([moduleId])
  @@map("lessons")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}
