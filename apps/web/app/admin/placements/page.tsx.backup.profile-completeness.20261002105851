  candidateId: string;
  companyName: string;
  jobTitle: string;
  jobLocation: string;
  employmentType: string;
  jobDescription: string;
  source: string;
  notes: string;
  status: string;
  appliedAt: string;
};

const EMPTY_FORM: ApplicationForm = {
  candidateId: '',
  companyName: '',
  jobTitle: '',
  jobLocation: '',
  employmentType: '',
  jobDescription: '',
  source: '',
  notes: '',
  status: 'DRAFT',
  appliedAt: '',
};

function dateInput(value?: string | null) {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}


function pretty(value?: string | null) {
  if (!value) return '—';
  return value
    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
    .replace(/[_-]/g, ' ')
    .toLowerCase()
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function dateText(value?: string | null) {
  if (!value) return '—';
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? value
    : date.toLocaleString();
}

function statusStyle(status?: string) {
  const value = (status ?? '').toUpperCase();
  if (['PLACED', 'ACCEPTED', 'PASSED', 'COMPLETED'].includes(value)) {
    return 'bg-emerald-100 text-emerald-300';
  }
  if (['REJECTED', 'DECLINED', 'FAILED', 'CANCELLED', 'WITHDRAWN', 'EXPIRED'].includes(value)) {
    return 'bg-rose-100 text-rose-300';
  }
  if (['INTERVIEW', 'SHORTLISTED', 'OFFERED', 'SCHEDULED'].includes(value)) {
    return 'bg-blue-950/60 text-blue-300';
  }
  return 'bg-amber-950/50 text-amber-300';
}

function Field({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <label className="block space-y-1.5">
      <span className="text-sm font-medium text-slate-200">{label}</span>
      {children}
    </label>
  );
}

const inputClass =
  'w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2.5 text-sm text-slate-100 outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-500/20';

function Button({
  children,
  onClick,
  disabled,
  variant = 'primary',
  type = 'button',
}: {
  children: React.ReactNode;
  onClick?: () => void;
  disabled?: boolean;
  variant?: 'primary' | 'secondary' | 'danger';
  type?: 'button' | 'submit';
}) {
  const styles = {
    primary: 'bg-indigo-600 text-white hover:bg-indigo-500',
    secondary: 'border border-slate-700 bg-slate-900 text-slate-200 hover:bg-slate-950',
    danger: 'bg-rose-600 text-white hover:bg-rose-700',
  };
  return (
    <button
      type={type}
      onClick={onClick}
      disabled={disabled}
      className={`inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-50 ${styles[variant]}`}
    >
      {children}
    </button>
  );
}


type ReadinessItem = {
  candidateId: string;
  checks: {
    expertMocks: { complete: boolean; completedCount: number; requiredCount: number };
    finalExpertMock: { complete: boolean; score: number | null; maxScore: number | null; requiredScore: number };
    expertApprovedProject: { complete: boolean; approvedCount: number };
    technicalAssessment: {
      complete: boolean;
      score: number | null;
      maxScore: number | null;
      evidenceType: string;
      formal15QuestionAssessmentVerified: boolean;
    };
  };
  allEvidenceComplete: boolean;
  decision: string;
  review?: { notes?: string | null; reviewedAt?: string | null } | null;
  expertMockInterviews: Array<{
    id: string; sequence: number; isFinal: boolean; status: string;
    score: number | null; maxScore: number | null;
    reviewerName?: string | null; feedback?: string | null;
  }>;
  projectReviews: Array<{
    id: string; projectName: string; status: string; expertApproved: boolean;
    reviewerName?: string | null; mentorFeedback?: string | null;
  }>;
  technicalAssessments: Array<{
    id: string; status: string; score: number | null; maxScore: number;
    updatedAt?: string;
  }>;
};

export default function PlacementsPage() {
  const [overview, setOverview] = useState<Overview | null>(null);
  const [applications, setApplications] = useState<Application[]>([]);
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('');
  const [pipelineStageFilter, setPipelineStageFilter] = useState('');
  const [appliedSearch, setAppliedSearch] = useState('');
  const [appliedStatus, setAppliedStatus] = useState('');
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [notice, setNotice] = useState('');
  const [showCreate, setShowCreate] = useState(false);
  const [selected, setSelected] = useState<Application | null>(null);
  const [editing, setEditing] = useState(false);
  const [form, setForm] = useState<ApplicationForm>(EMPTY_FORM);
  const [saving, setSaving] = useState(false);
  const [actionError, setActionError] = useState('');
  const [interviewForm, setInterviewForm] = useState({
    round: '1',
    title: '',
    scheduledAt: '',
    durationMins: '60',
    mode: 'ONLINE',
    meetingLink: '',
    interviewer: '',
  });
  const [offerForm, setOfferForm] = useState({
    compensation: '',
    currency: 'INR',
    offeredAt: '',
    expiresAt: '',
    joiningDate: '',
    notes: '',
  });

  const token = () =>
    typeof window === 'undefined'
      ? null
      : window.sessionStorage.getItem('tekrovia_access_token');

  const request = useCallback(async (path: string, init: RequestInit = {}) => {
    const accessToken = token();
    if (!accessToken) {
      throw new Error('Your session is missing. Please sign in again.');
    }

    const response = await fetch(`${API_BASE}${path}`, {
      ...init,
      headers: {
        Authorization: `Bearer ${accessToken}`,
        Accept: 'application/json',
        ...(init.body ? { 'Content-Type': 'application/json' } : {}),
        ...init.headers,
      },
    });

    const text = await response.text();
    let data: unknown;
    try {
      data = text ? JSON.parse(text) : null;
    } catch {
      data = text;
    }

    if (!response.ok) {
      const record = data && typeof data === 'object'
        ? data as { message?: string | string[]; error?: string }
        : {};
      const message = Array.isArray(record.message)
        ? record.message.join(', ')
        : record.message ?? record.error;
      throw new Error(message || `Request failed (${response.status}).`);
    }
    return data;
  }, []);

  const loadDashboard = useCallback(async () => {
    setLoading(true);
    setError('');
    try {
      const params = new URLSearchParams({ page: '1', limit: '20' });
      if (appliedSearch.trim()) params.set('search', appliedSearch.trim());
      if (appliedStatus) params.set('status', appliedStatus);

      const [overviewData, applicationData] = await Promise.all([
        request('/placements/overview'),
        request(`/placements/applications?${params.toString()}`),
      ]);

      setOverview(overviewData as Overview);
      const result = applicationData as { items?: Application[] };
      setApplications(Array.isArray(result?.items) ? result.items : []);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Unable to load placement data.');
    } finally {
      setLoading(false);
    }
  }, [appliedSearch, appliedStatus, request]);

  useEffect(() => {
    void loadDashboard();
  }, [loadDashboard]);

  const refreshSelected = async (id: string) => {
    const data = await request(`/placements/applications/${id}`);
    setSelected(data as Application);
    await loadDashboard();
  };

  const openDetails = async (application: Application) => {
    setActionError('');
    setEditing(false);
    setSelected(application);
    try {
      const data = await request(`/placements/applications/${application.id}`);
      setSelected(data as Application);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not load application details.');
    }
  };

  const startEdit = () => {
    if (!selected) return;
    setForm({
      candidateId: selected.candidateId ?? '',
      companyName: selected.companyName ?? '',
      jobTitle: selected.jobTitle ?? '',
      jobLocation: selected.jobLocation ?? '',
      employmentType: selected.employmentType ?? '',
      jobDescription: selected.jobDescription ?? '',
      source: selected.source ?? '',
      notes: selected.notes ?? '',
      status: selected.status ?? 'DRAFT',
      appliedAt: dateInput(selected.appliedAt),
    });
    setEditing(true);
    setActionError('');
  };

  const submitApplication = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setSaving(true);
    setActionError('');
    try {
      const payload = {
        ...form,
        appliedAt: form.appliedAt || null,
      };
      const created = await request('/placements/applications', {
        method: 'POST',
        body: JSON.stringify(payload),
      }) as Application;

      setShowCreate(false);
      setForm(EMPTY_FORM);
      setNotice('Application created successfully.');
      await loadDashboard();
      if (created?.id) await openDetails(created);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not create application.');
    } finally {
      setSaving(false);
    }
  };

  const saveApplication = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (!selected) return;
    setSaving(true);
    setActionError('');
    try {
      await request(`/placements/applications/${selected.id}`, {
        method: 'PATCH',
        body: JSON.stringify({
          companyName: form.companyName,
          jobTitle: form.jobTitle,
          jobLocation: form.jobLocation || null,
          employmentType: form.employmentType || null,
          jobDescription: form.jobDescription || null,
          source: form.source || null,
          notes: form.notes || null,
          status: form.status,
          appliedAt: form.appliedAt || null,
        }),
      });
      setEditing(false);
      setNotice('Application updated successfully.');
      await refreshSelected(selected.id);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not update application.');
    } finally {
      setSaving(false);
    }
  };

  const updatePipelineStage = async (stage: string, note: string) => {
    if (!selected) return;
    setSaving(true);
    setActionError('');
    try {
      await request(`/placements/applications/${selected.id}/pipeline`, {
        method: 'PATCH',
        body: JSON.stringify({ stage, note: note.trim() || undefined }),
      });
      setNotice(`Pipeline stage updated to ${pretty(stage)}.`);
      await refreshSelected(selected.id);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not update pipeline stage.');
    } finally {
      setSaving(false);
    }
  };

  const scheduleInterview = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (!selected) return;
    setSaving(true);
    setActionError('');
    try {
      await request(`/placements/applications/${selected.id}/interviews`, {
        method: 'POST',
        body: JSON.stringify({
          ...interviewForm,
          round: Number(interviewForm.round),
          durationMins: interviewForm.durationMins
            ? Number(interviewForm.durationMins)
            : null,
          scheduledAt: new Date(interviewForm.scheduledAt).toISOString(),
        }),
      });
      setInterviewForm({
        round: String((selected.interviews?.length ?? 0) + 2),
        title: '',
        scheduledAt: '',
        durationMins: '60',
        mode: 'ONLINE',
        meetingLink: '',
        interviewer: '',
      });
      setNotice('Interview scheduled successfully.');
      await refreshSelected(selected.id);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not schedule interview.');
    } finally {
      setSaving(false);
    }
  };

  const updateInterview = async (
    interview: Interview,
    changes: Partial<Interview>,
  ) => {
    if (!selected) return;
    setSaving(true);
    setActionError('');
    try {
      await request(`/placements/interviews/${interview.id}`, {
        method: 'PATCH',
        body: JSON.stringify(changes),
      });
      setNotice('Interview updated successfully.');
      await refreshSelected(selected.id);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not update interview.');
    } finally {
      setSaving(false);
    }
  };

  const createOffer = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (!selected) return;
    setSaving(true);
    setActionError('');
    try {
      await request(`/placements/applications/${selected.id}/offer`, {
        method: 'POST',
        body: JSON.stringify({
          compensation: offerForm.compensation
            ? Number(offerForm.compensation)
            : null,
          currency: offerForm.currency,
          offeredAt: offerForm.offeredAt || null,
          expiresAt: offerForm.expiresAt || null,
          joiningDate: offerForm.joiningDate || null,
          notes: offerForm.notes || null,
        }),
      });
      setNotice('Offer created successfully.');
      await refreshSelected(selected.id);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not create offer.');
    } finally {
      setSaving(false);
    }
  };

  const updateOffer = async (offer: Offer, changes: Partial<Offer>) => {
    if (!selected) return;
    setSaving(true);
    setActionError('');
    try {
      await request(`/placements/offers/${offer.id}`, {
        method: 'PATCH',
        body: JSON.stringify(changes),
      });
      setNotice('Offer updated successfully.');
      await refreshSelected(selected.id);
    } catch (err) {
      setActionError(err instanceof Error ? err.message : 'Could not update offer.');
    } finally {
      setSaving(false);
    }
  };

  const visibleApplications = applications.filter((application) =>
    !pipelineStageFilter || application.pipelineStage === pipelineStageFilter
  );

  const metricCards = [
    ...Object.entries(overview?.applicationCounts ?? {}).map(([key, value]) => [
      `Applications · ${pretty(key)}`, String(value),
    ]),
    ['Scheduled interviews', String(overview?.scheduledInterviewCount ?? 0)],
    ...Object.entries(overview?.offerCounts ?? {}).map(([key, value]) => [
      `Offers · ${pretty(key)}`, String(value),
    ]),
  ];

  const closeDetails = () => {
    setSelected(null);
    setEditing(false);
    setActionError('');
  };


  const [readinessItems, setReadinessItems] = useState<ReadinessItem[]>([]);
  const [readinessLoading, setReadinessLoading] = useState(false);
  const [readinessError, setReadinessError] = useState("");
  const [readinessSearch, setReadinessSearch] = useState("");
  const [readinessDecisionFilter, setReadinessDecisionFilter] = useState("");
  const [selectedReadiness, setSelectedReadiness] = useState<ReadinessItem | null>(null);
  const [readinessNotes, setReadinessNotes] = useState("");
  const [readinessSaving, setReadinessSaving] = useState(false);

  const loadReadiness = useCallback(async () => {
    setReadinessLoading(true);
    setReadinessError("");
    try {
      const response = await fetch(`${API_BASE}/placements/readiness`, {
        headers: {
          Authorization: `Bearer ${token()}`,
          "Content-Type": "application/json",
        },
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(payload?.message || "Unable to load readiness records.");
      }
      const items: ReadinessItem[] = Array.isArray(payload?.items) ? payload.items : [];
      setReadinessItems(items);
      setSelectedReadiness((current) =>
        current ? items.find((item) => item.candidateId === current.candidateId) ?? null : null
      );
    } catch (error) {
      setReadinessError(error instanceof Error ? error.message : "Unable to load readiness records.");
    } finally {
      setReadinessLoading(false);
    }
  }, []);

  useEffect(() => {
    void loadReadiness();
  }, [loadReadiness]);

  const saveReadinessReview = async (decision: "APPROVED" | "NEEDS_WORK" | "PENDING") => {
    if (!selectedReadiness || (decision === "APPROVED" && !selectedReadiness.allEvidenceComplete)) return;
    setReadinessSaving(true);
    setReadinessError("");
    try {
      const response = await fetch(
        `${API_BASE}/placements/readiness/${encodeURIComponent(selectedReadiness.candidateId)}/review`,
        {
          method: "PATCH",
          headers: {
            Authorization: `Bearer ${token()}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ decision, notes: readinessNotes }),
        },
      );
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(payload?.message || "Unable to save readiness review.");
      }
      await loadReadiness();
    } catch (error) {
      setReadinessError(error instanceof Error ? error.message : "Unable to save readiness review.");
    } finally {
      setReadinessSaving(false);
    }
  };

  const filteredReadinessItems = readinessItems.filter((item) =>
    item.candidateId.toLowerCase().includes(readinessSearch.trim().toLowerCase()) &&
    (!readinessDecisionFilter || item.decision === readinessDecisionFilter)
  );

  const readinessCompleteCount = readinessItems.filter((item) => item.allEvidenceComplete).length;
  const readinessPendingCount = readinessItems.filter((item) => item.decision === "PENDING").length;
  const readinessApprovedCount = readinessItems.filter((item) => item.decision === "APPROVED").length;

  const activeApplicationCount = ["APPLIED", "SHORTLISTED", "INTERVIEW", "OFFERED"]
    .reduce((total, status) => total + (overview?.applicationCounts?.[status] ?? 0), 0);

  const offersReceivedCount = Object.values(overview?.offerCounts ?? {})
    .reduce((total, count) => total + count, 0);

  const analyticsCards = [
    { label: "Total candidates", value: readinessItems.length, detail: "Candidates with readiness records" },
    { label: "Readiness approved", value: readinessApprovedCount, detail: "Human-approved candidates" },
    { label: "Active applications", value: activeApplicationCount, detail: "Applied, shortlisted, interview or offered" },
    { label: "Offers received", value: offersReceivedCount, detail: "Recorded offers across all statuses" },
  ];

  return (
    <main className="min-h-screen bg-slate-950 px-4 py-6 text-slate-100 sm:px-6 lg:px-8">
      <div className="mx-auto max-w-7xl space-y-6">
        <header className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
          <div>
            <div className="mb-2 text-sm text-slate-400">
              <Link href="/admin" className="hover:text-indigo-300">Admin</Link>
              <span className="mx-2">/</span>
              <span>Placements</span>
            </div>
            <h1 className="text-2xl font-bold tracking-tight sm:text-3xl">
              Placement Management
            </h1>
            <p className="mt-1 text-sm text-slate-300">
              Track candidate applications, interviews and offers.
            </p>
          </div>
          <div className="flex flex-wrap gap-2">
            <Button variant="secondary" onClick={() => void loadDashboard()} disabled={loading}>
              {loading ? 'Refreshing…' : 'Refresh data'}
            </Button>
            <Button onClick={() => {
              setForm(EMPTY_FORM);
              setActionError('');
              setShowCreate(true);
            }}>
              + New application
            </Button>
          </div>
        </header>

        {error && (
          <div role="alert" className="rounded-xl border border-rose-800 bg-rose-950/40 p-4 text-sm text-rose-300">
            <p className="font-semibold">Could not load placement data</p>
            <p className="mt-1">{error}</p>
            <Link href="/login" className="mt-2 inline-block font-semibold underline">
              Go to login
            </Link>
          </div>
        )}
        {notice && (
          <div role="status" className="flex items-center justify-between rounded-xl border border-emerald-800 bg-emerald-950/40 p-3 text-sm text-emerald-300">
            {notice}
            <button onClick={() => setNotice('')} aria-label="Dismiss notice">✕</button>
          </div>
        )}

        <section aria-label="Placement analytics" className="space-y-3">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 className="text-lg font-semibold">Placement Analytics</h2>
              <p className="mt-1 text-sm text-slate-400">
                Candidate readiness and placement pipeline at a glance.
              </p>
            </div>
            <span className="text-xs text-slate-400">
              {loading || readinessLoading ? "Updating metrics…" : "Based on current API data"}
            </span>
          </div>

          <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {analyticsCards.map((card) => (
              <article
                key={card.label}
                className="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-sm"
              >
                <p className="text-sm font-medium text-slate-400">{card.label}</p>
                <p className="mt-3 text-3xl font-bold tracking-tight text-slate-100">
                  {loading || readinessLoading ? "—" : card.value.toLocaleString()}
                </p>
                <p className="mt-2 text-xs text-slate-400">{card.detail}</p>
              </article>
            ))}
          </div>
        </section>

        <section aria-label="Placement overview">
          <div className="mb-3 flex items-center justify-between">
            <h2 className="text-lg font-semibold">Overview</h2>
            <span className="text-xs text-slate-400">Live API data</span>
          </div>
          {metricCards.length ? (
            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {metricCards.map(([label, value]) => (
