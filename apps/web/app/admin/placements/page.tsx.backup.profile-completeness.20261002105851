                      <Field label="Source"><input className={inputClass} value={form.source} onChange={(e) => setForm({ ...form, source: e.target.value })} /></Field>
                    </div>
                    <Field label="Job description"><textarea rows={3} className={inputClass} value={form.jobDescription} onChange={(e) => setForm({ ...form, jobDescription: e.target.value })} /></Field>
                    <Field label="Notes"><textarea rows={3} className={inputClass} value={form.notes} onChange={(e) => setForm({ ...form, notes: e.target.value })} /></Field>
                    <div className="flex flex-wrap justify-end gap-2">
                      <Button variant="secondary" onClick={() => setEditing(false)}>Cancel</Button>
                      <Button type="submit" disabled={saving}>{saving ? 'Saving…' : 'Save changes'}</Button>
                    </div>
                  </form>
                ) : (
                  <div className="grid gap-4 rounded-xl border border-slate-800 p-4 sm:grid-cols-2 lg:grid-cols-3">
                    {[
                      ['Candidate ID', selected.candidateId],
                      ['Company', selected.companyName],
                      ['Job title', selected.jobTitle],
                      ['Location', selected.jobLocation],
                      ['Employment type', pretty(selected.employmentType)],
                      ['Status', pretty(selected.status)],
                      ['Source', selected.source],
                      ['Applied date', dateText(selected.appliedAt)],
                      ['Updated', dateText(selected.updatedAt)],
                    ].map(([label, value]) => (
                      <div key={label}>
                        <p className="text-xs font-medium uppercase tracking-wide text-slate-400">{label}</p>
                        <p className="mt-1 break-words text-sm font-medium text-slate-800">{value || '—'}</p>
                      </div>
                    ))}
                    {selected.jobDescription && <div className="sm:col-span-2 lg:col-span-3"><p className="text-xs font-medium uppercase text-slate-400">Job description</p><p className="mt-1 whitespace-pre-wrap text-sm">{selected.jobDescription}</p></div>}
                    {selected.notes && <div className="sm:col-span-2 lg:col-span-3"><p className="text-xs font-medium uppercase text-slate-400">Notes</p><p className="mt-1 whitespace-pre-wrap text-sm">{selected.notes}</p></div>}
                  </div>
                )}
              </section>

              <section className="border-t border-slate-800 pt-6">
                <div className="mb-4">
                  <h3 className="text-lg font-semibold">Placement pipeline stage</h3>
                  <p className="mt-1 text-sm text-slate-400">
                    This workflow stage is tracked separately from the application status.
                    Stage changes are recorded in the audit history.
                  </p>
                </div>

                <div className="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
                  <Field label="Current pipeline stage">
                    <select
                      className={inputClass}
                      value={selected.pipelineStage ?? 'PROFILE_REVIEW'}
                      disabled={saving}
                      onChange={(event) => {
                        const nextStage = event.target.value;
                        const note = window.prompt(
                          'Add an optional note for this stage change:',
                          '',
                        );
                        if (note === null) return;
                        void updatePipelineStage(nextStage, note);
                      }}
                    >
                      {PIPELINE_STAGES.map((stage) => (
                        <option key={stage} value={stage}>{pretty(stage)}</option>
                      ))}
                    </select>
                  </Field>
                  <div className="rounded-xl border border-slate-800 bg-slate-950 p-4">
                    <p className="text-xs font-semibold uppercase tracking-wide text-slate-400">
                      Current stage
                    </p>
                    <p className="mt-2 text-lg font-bold text-indigo-200">
                      {pretty(selected.pipelineStage ?? 'PROFILE_REVIEW')}
                    </p>
                    <p className="mt-1 text-xs text-slate-400">
                      {selected.pipelineHistory?.length ?? 0} recorded stage changes
                    </p>
                  </div>
                </div>

                <div className="mt-5">
                  <h4 className="mb-3 font-semibold">Stage history</h4>
                  {selected.pipelineHistory?.length ? (
                    <ol className="space-y-3">
                      {selected.pipelineHistory.map((entry) => (
                        <li key={entry.id} className="relative rounded-xl border border-slate-800 bg-slate-950 p-4">
                          <div className="flex flex-wrap items-center justify-between gap-2">
                            <p className="text-sm font-semibold">
                              {entry.fromStage ? pretty(entry.fromStage) : 'Initial stage'}
                              {' → '}
                              {pretty(entry.toStage)}
                            </p>
                            <time className="text-xs text-slate-400">
                              {dateText(entry.createdAt)}
                            </time>
                          </div>
                          {entry.note && (
                            <p className="mt-2 whitespace-pre-wrap text-sm text-slate-300">
                              {entry.note}
                            </p>
                          )}
                          <p className="mt-2 text-xs text-slate-500">
                            Changed by:{' '}
                            {entry.changedByUser?.name?.trim() ||
                              (entry.changedByUserId
                                ? `User (${entry.changedByUserId})`
                                : 'User not recorded')}
                          </p>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <p className="rounded-lg border border-dashed border-slate-700 p-4 text-sm text-slate-400">
                      No stage changes have been recorded for this application yet.
                    </p>
                  )}
                </div>
              </section>

              <section className="border-t border-slate-800 pt-6">
                <h3 className="mb-4 text-lg font-semibold">Interviews ({selected.interviews?.length ?? 0})</h3>
                <div className="space-y-3">
                  {(selected.interviews ?? []).map((interview) => (
                    <article key={interview.id} className="rounded-xl border border-slate-800 p-4">
                      <div className="flex flex-wrap items-start justify-between gap-2">
                        <div>
                          <p className="font-semibold">{interview.title || `Interview round ${interview.round ?? 1}`}</p>
                          <p className="mt-1 text-sm text-slate-300">{dateText(interview.scheduledAt)} · {interview.durationMins ?? '—'} min · {pretty(interview.mode)}</p>
                          {interview.interviewer && <p className="mt-1 text-sm text-slate-300">Interviewer: {interview.interviewer}</p>}
                          {interview.meetingLink && <a className="mt-1 inline-block text-sm text-indigo-300 underline" href={interview.meetingLink} target="_blank" rel="noreferrer">Meeting link</a>}
                          {interview.feedback && <p className="mt-2 whitespace-pre-wrap text-sm text-slate-300">Feedback: {interview.feedback}</p>}
                        </div>
                        <span className={`rounded-full px-2.5 py-1 text-xs font-semibold ${statusStyle(interview.status)}`}>{pretty(interview.status)}</span>
                      </div>
                      <div className="mt-4 grid gap-3 sm:grid-cols-3">
                        <Field label="Interview status"><select className={inputClass} value={interview.status ?? 'SCHEDULED'} onChange={(e) => void updateInterview(interview, { status: e.target.value })} disabled={saving}>{INTERVIEW_STATUSES.map((v) => <option key={v} value={v}>{pretty(v)}</option>)}</select></Field>
                        <Field label="Outcome"><select className={inputClass} value={interview.outcome ?? 'PENDING'} onChange={(e) => void updateInterview(interview, { outcome: e.target.value })} disabled={saving}>{INTERVIEW_OUTCOMES.map((v) => <option key={v} value={v}>{pretty(v)}</option>)}</select></Field>
                        <Field label="Feedback"><input className={inputClass} defaultValue={interview.feedback ?? ''} placeholder="Feedback" onBlur={(e) => { if (e.target.value !== (interview.feedback ?? '')) void updateInterview(interview, { feedback: e.target.value }); }} disabled={saving} /></Field>
                      </div>
                    </article>
                  ))}
                  {!selected.interviews?.length && <p className="rounded-lg bg-slate-950 p-4 text-sm text-slate-400">No interviews scheduled for this application yet.</p>}
                </div>

                <form onSubmit={scheduleInterview} className="mt-4 space-y-4 rounded-xl border border-dashed border-slate-700 p-4">
                  <h4 className="font-semibold">Schedule an interview</h4>
                  <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    <Field label="Round"><input required min="1" type="number" className={inputClass} value={interviewForm.round} onChange={(e) => setInterviewForm({ ...interviewForm, round: e.target.value })} /></Field>
                    <Field label="Interview title"><input className={inputClass} value={interviewForm.title} onChange={(e) => setInterviewForm({ ...interviewForm, title: e.target.value })} placeholder="Technical round" /></Field>
                    <Field label="Scheduled at *"><input required type="datetime-local" className={inputClass} value={interviewForm.scheduledAt} onChange={(e) => setInterviewForm({ ...interviewForm, scheduledAt: e.target.value })} /></Field>
                    <Field label="Duration (minutes)"><input min="1" max="1440" type="number" className={inputClass} value={interviewForm.durationMins} onChange={(e) => setInterviewForm({ ...interviewForm, durationMins: e.target.value })} /></Field>
                    <Field label="Mode"><select className={inputClass} value={interviewForm.mode} onChange={(e) => setInterviewForm({ ...interviewForm, mode: e.target.value })}><option value="ONLINE">Online</option><option value="ONSITE">Onsite</option><option value="PHONE">Phone</option></select></Field>
                    <Field label="Interviewer"><input className={inputClass} value={interviewForm.interviewer} onChange={(e) => setInterviewForm({ ...interviewForm, interviewer: e.target.value })} /></Field>
                    <div className="sm:col-span-2 lg:col-span-3"><Field label="Meeting link"><input type="url" className={inputClass} value={interviewForm.meetingLink} onChange={(e) => setInterviewForm({ ...interviewForm, meetingLink: e.target.value })} placeholder="https://…" /></Field></div>
                  </div>
                  <div className="flex justify-end"><Button type="submit" disabled={saving}>{saving ? 'Scheduling…' : 'Schedule interview'}</Button></div>
                </form>
              </section>

              <section className="border-t border-slate-800 pt-6">
                <h3 className="mb-4 text-lg font-semibold">Offer management</h3>
                {selected.offer ? (
                  <div className="space-y-4 rounded-xl border border-slate-800 p-4">
                    <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                      <div><p className="text-xs uppercase text-slate-400">Status</p><span className={`mt-1 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${statusStyle(selected.offer.status)}`}>{pretty(selected.offer.status)}</span></div>
                      <div><p className="text-xs uppercase text-slate-400">Compensation</p><p className="mt-1 font-semibold">{selected.offer.compensation == null ? '—' : `${selected.offer.currency ?? 'INR'} ${selected.offer.compensation.toLocaleString()}`}</p></div>
                      <div><p className="text-xs uppercase text-slate-400">Offered date</p><p className="mt-1 text-sm">{dateText(selected.offer.offeredAt)}</p></div>
                      <div><p className="text-xs uppercase text-slate-400">Expiry date</p><p className="mt-1 text-sm">{dateText(selected.offer.expiresAt)}</p></div>
                      <div><p className="text-xs uppercase text-slate-400">Joining date</p><p className="mt-1 text-sm">{dateText(selected.offer.joiningDate)}</p></div>
                      <div><p className="text-xs uppercase text-slate-400">Notes</p><p className="mt-1 text-sm">{selected.offer.notes || '—'}</p></div>
                    </div>
                    <Field label="Update offer status">
                      <select className={inputClass} value={selected.offer.status ?? 'PENDING'} disabled={saving} onChange={(e) => void updateOffer(selected.offer!, { status: e.target.value })}>
                        {OFFER_STATUSES.map((v) => <option key={v} value={v}>{pretty(v)}</option>)}
                      </select>
                    </Field>
                  </div>
                ) : (
                  <form onSubmit={createOffer} className="space-y-4 rounded-xl border border-dashed border-slate-700 p-4">
                    <p className="text-sm text-slate-300">No offer has been recorded for this application. Create one below.</p>
                    <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                      <Field label="Compensation"><input min="0" type="number" step="0.01" className={inputClass} value={offerForm.compensation} onChange={(e) => setOfferForm({ ...offerForm, compensation: e.target.value })} placeholder="Annual amount" /></Field>
                      <Field label="Currency"><select className={inputClass} value={offerForm.currency} onChange={(e) => setOfferForm({ ...offerForm, currency: e.target.value })}><option value="INR">INR</option><option value="USD">USD</option><option value="EUR">EUR</option></select></Field>
                      <Field label="Offered date"><input type="date" className={inputClass} value={offerForm.offeredAt} onChange={(e) => setOfferForm({ ...offerForm, offeredAt: e.target.value })} /></Field>
                      <Field label="Expiry date"><input type="date" className={inputClass} value={offerForm.expiresAt} onChange={(e) => setOfferForm({ ...offerForm, expiresAt: e.target.value })} /></Field>
                      <Field label="Joining date"><input type="date" className={inputClass} value={offerForm.joiningDate} onChange={(e) => setOfferForm({ ...offerForm, joiningDate: e.target.value })} /></Field>
                    </div>
                    <Field label="Offer notes"><textarea rows={2} className={inputClass} value={offerForm.notes} onChange={(e) => setOfferForm({ ...offerForm, notes: e.target.value })} /></Field>
                    <div className="flex justify-end"><Button type="submit" disabled={saving}>{saving ? 'Creating…' : 'Create offer'}</Button></div>
                  </form>
                )}
              </section>
            </div>
            <div className="flex justify-end border-t border-slate-800 px-6 py-4">
              <Button variant="secondary" onClick={closeDetails}>Close</Button>
            </div>
          </section>
        </div>
      )}
    </main>
  );
}
