DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tekrovia?schema=public"

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# OTP dev mode — set to 'true' only in local dev, never in production
ALLOW_DEV_OTP_RESPONSE="false"

# AI Service — shared secret between NestJS and FastAPI (must match on both sides)
AI_SERVICE_SECRET="change_this_to_a_long_random_secret"

# AI Service CORS — comma-separated allowed origins
AI_CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# ── Docker / Infrastructure ────────────────────────────────────────────────
POSTGRES_DB="tekrovia"
POSTGRES_USER="tekrovia_user"
# ✅ Never commit a real password — generate with: openssl rand -hex 32
POSTGRES_PASSWORD="CHANGE_ME_generate_with_openssl_rand_hex_32"

# Redis password — must match REDIS_URL below
# ✅ Generate with: openssl rand -hex 32
REDIS_PASSWORD="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ── NestJS API ─────────────────────────────────────────────────────────────
# Update REDIS_URL to include the password
REDIS_URL="redis://localhost:6379"
# REDIS_URL="redis://:${REDIS_PASSWORD}@localhost:6380"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS="http://localhost:3000"
